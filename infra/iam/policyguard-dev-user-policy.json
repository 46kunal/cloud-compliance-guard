{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScanReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrailStatus",
        "cloudtrail:LookupEvents",
        "ec2:DescribeSecurityGroups",
        "iam:GetLoginProfile",
        "iam:GetPolicyVersion",
        "iam:ListEntitiesForPolicy",
        "iam:ListMFADevices",
        "iam:ListPolicies",
        "iam:ListUsers",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetEncryptionConfiguration",
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DemoBucketsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::policyguard-demo-*",
        "arn:aws:s3:::policyguard-demo-*/*"
      ]
    },
    {
      "Sid": "DemoIamOnly",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateLoginProfile",
        "iam:CreatePolicy",
        "iam:CreateRole",
        "iam:CreateUser",
        "iam:DeleteLoginProfile",
        "iam:DeletePolicy",
        "iam:DeleteRole",
        "iam:DeleteUser",
        "iam:DetachGroupPolicy",
        "iam:DetachRolePolicy",
        "iam:DetachUserPolicy",
        "iam:TagPolicy",
        "iam:TagRole",
        "iam:TagUser"
      ],
      "Resource": [
        "arn:aws:iam::*:policy/policyguard-demo-*",
        "arn:aws:iam::*:role/policyguard-demo-*",
        "arn:aws:iam::*:user/policyguard-demo-*"
      ]
    }
  ]
}
